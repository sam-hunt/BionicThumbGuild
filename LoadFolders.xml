<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!--
    LoadFolders.xml - Tells RimWorld which folders to load based on game version.

    This mod requires RimWorld 1.6+.
    Version-specific content (Assemblies, Defs, Patches) lives in the 1.6/ folder.
    The root "/" loads About/ and other shared metadata, rather than everything,
    since RimWorld only looks for well-known folders within these directories
  -->
  <v1.6>
    <li>/</li>
    <li>1.6</li>
  </v1.6>
  <v1.7>
    <!-- 1.7 runs the 1.6 tree unchanged: the Waylith CLR maps every UnityEngine
         reference onto UnityStubs, so the net472 assembly loads as-is. Listed
         explicitly rather than left to the game's highest-lower-version fallback. -->
    <li>/</li>
    <li>1.6</li>
  </v1.7>
</loadFolders>
